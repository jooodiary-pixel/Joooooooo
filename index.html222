<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>iPhone UI Mockup</title>
<style>
:root{
  --blue:#007aff;
  --text:#0b0b0c;
  --sub:#8e8e93;
  --line:#e5e5ea;
  --card:rgba(255,255,255,.80);
}
*{box-sizing:border-box}
html,body{
  margin:0;
  width:100%;
  min-height:100%;
  font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","Helvetica Neue",Arial,sans-serif;
  background:#eef2f5;
  color:var(--text);
}
body{
  display:flex;
  align-items:center;
  justify-content:center;
  padding:18px;
}
.phone{
  width:min(390px,100vw);
  height:min(844px,100vh);
  border-radius:34px;
  overflow:hidden;
  position:relative;
  background:#fff;
  box-shadow:0 18px 50px rgba(0,0,0,.14);
  border:1px solid rgba(0,0,0,.08);
}
.wallpaper{
  background:
    radial-gradient(120% 70% at 20% 0%, rgba(255,255,255,.95), transparent 55%),
    radial-gradient(70% 55% at 92% 22%, rgba(202,211,220,.85), transparent 58%),
    radial-gradient(95% 70% at 15% 84%, rgba(202,211,220,.82), transparent 56%),
    radial-gradient(75% 55% at 96% 90%, rgba(240,244,247,.95), transparent 58%),
    linear-gradient(145deg,#eef2f5 0%,#dce3e9 45%,#f6f8fa 100%);
}
.wallpaper:before,.wallpaper:after{
  content:"";
  position:absolute;
  border:2px solid rgba(255,255,255,.55);
  border-radius:50%;
  pointer-events:none;
}
.wallpaper:before{
  width:460px;height:230px;
  left:-170px;top:250px;
  transform:rotate(-18deg);
  box-shadow:0 0 40px rgba(255,255,255,.5) inset;
}
.wallpaper:after{
  width:420px;height:180px;
  right:-220px;top:65px;
  transform:rotate(28deg);
}
.screen{
  position:absolute;inset:0;
  display:none;
  background:#fff;
}
.screen.active{display:block}
.statusbar{
  height:48px;
  padding:12px 18px 0;
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  font-weight:700;
  font-size:16px;
  position:relative;
  z-index:20;
}
.statusicons{
  display:flex;gap:7px;align-items:center;
}
.signal{display:flex;gap:2px;align-items:flex-end;height:15px}
.signal i{display:block;width:3px;background:#000;border-radius:2px}
.signal i:nth-child(1){height:5px}.signal i:nth-child(2){height:8px}.signal i:nth-child(3){height:11px}.signal i:nth-child(4){height:14px}
.wifi{
  width:18px;height:14px;position:relative;
}
.wifi:before,.wifi:after{
  content:"";position:absolute;left:50%;transform:translateX(-50%);
  border:2px solid #000;border-color:#000 transparent transparent transparent;border-radius:50%;
}
.wifi:before{width:18px;height:18px;top:0}
.wifi:after{width:10px;height:10px;top:5px}
.wifi i{
  width:4px;height:4px;background:#000;border-radius:50%;
  position:absolute;bottom:0;left:7px;
}
.battery{
  width:25px;height:12px;border:1.8px solid #111;border-radius:3px;position:relative;
}
.battery:after{content:"";position:absolute;right:-3px;top:3px;width:2px;height:5px;background:#111;border-radius:1px}
.battery i{display:block;width:18px;height:7px;background:#111;margin:1.5px;border-radius:1px}

/* HOME */
#home{position:absolute;inset:0}
.home-content{position:absolute;inset:48px 0 0;padding:28px 22px 0}
.apps{
  display:grid;grid-template-columns:repeat(4,1fr);
  gap:22px 18px;
}
.app{
  text-align:center;font-size:12px;cursor:pointer;user-select:none;
}
.icon{
  width:64px;height:64px;margin:0 auto 7px;border-radius:15px;position:relative;
  box-shadow:inset 0 0 0 1px rgba(0,0,0,.04), 0 1px 1px rgba(0,0,0,.04);
  overflow:hidden;
}
.icon .emoji{font-size:34px;line-height:64px}
.facetime{background:linear-gradient(#5df28f,#0ac746)}
.facetime:before{content:"";position:absolute;width:30px;height:22px;background:#fff;border-radius:6px;left:13px;top:21px}
.facetime:after{content:"";position:absolute;border-left:10px solid #fff;border-top:8px solid transparent;border-bottom:8px solid transparent;right:9px;top:24px}
.calendar{background:#fff}
.calendar .dow{font-size:10px;color:#ff3b30;font-weight:700;margin-top:8px}
.calendar .date{font-size:33px;line-height:37px}
.photos{background:#fff}
.photos:before{
  content:"";position:absolute;inset:12px;border-radius:50%;
  background:conic-gradient(#ff3b30,#ff9500,#ffcc00,#34c759,#30b0c7,#007aff,#5856d6,#af52de,#ff2d55,#ff3b30);
}
.photos:after{content:"";position:absolute;inset:23px;background:#fff;border-radius:50%}
.camera{background:linear-gradient(#e8e8ea,#bfc0c4)}
.camera:before{content:"";position:absolute;width:35px;height:25px;background:#29292c;border-radius:6px;left:15px;top:22px}
.camera:after{content:"";position:absolute;width:15px;height:15px;border:3px solid #aaa;border-radius:50%;left:23px;top:25px}
.mail{background:linear-gradient(#22a8ff,#007aff)}
.mail:before{content:"";position:absolute;left:11px;right:11px;top:17px;bottom:17px;background:#fff;border-radius:3px}
.mail:after{content:"";position:absolute;left:12px;top:17px;border-left:20px solid transparent;border-right:20px solid transparent;border-top:16px solid #8fd0ff}
.clock{background:#fff}
.clock:before{content:"";position:absolute;inset:7px;border-radius:50%;border:2px solid #111;background:#fff}
.clock:after{content:"";position:absolute;width:2px;height:18px;background:#111;left:31px;top:17px;transform-origin:bottom;transform:rotate(34deg)}
.maps{background:linear-gradient(135deg,#d6f8d7 0 35%,#7ed889 35% 47%,#e9d1ef 47% 62%,#8acdf4 62%)}
.maps:before{content:"A";position:absolute;left:22px;top:12px;width:22px;height:34px;border-radius:14px;color:#fff;background:#2385ff;font-size:22px;line-height:34px;font-weight:700}
.weather{background:linear-gradient(#0b9cff,#4dc4ff)}
.weather:before{content:"";position:absolute;width:25px;height:25px;border-radius:50%;background:#ffd44f;right:10px;top:10px}
.weather:after{content:"☁";position:absolute;left:9px;bottom:7px;font-size:36px;color:white;text-shadow:0 1px 2px rgba(0,0,0,.12)}
.reminders{background:#fff}
.reminders:before{content:"";position:absolute;left:14px;top:15px;width:8px;height:8px;border-radius:50%;background:#007aff;box-shadow:0 13px 0 #ff3b30,0 26px 0 #ffcc00}
.reminders:after{content:"";position:absolute;left:28px;right:10px;top:18px;height:2px;background:#c8c8cc;box-shadow:0 13px 0 #c8c8cc,0 26px 0 #c8c8cc}
.notes{background:linear-gradient(#ffd54a 0 18%,#fff 18%)}
.notes:before{content:"";position:absolute;left:11px;right:11px;top:25px;height:1px;background:#d8d8dc;box-shadow:0 9px 0 #d8d8dc,0 18px 0 #d8d8dc,0 27px 0 #d8d8dc}
.appstore{background:linear-gradient(#19b5ff,#007aff)}
.appstore:before{content:"A";position:absolute;inset:0;color:#fff;font-weight:500;font-size:38px;line-height:64px}
.settings{background:linear-gradient(#e5e5e7,#babcc0)}
.settings:before{content:"⚙";position:absolute;inset:0;font-size:44px;line-height:64px;color:#4d4e52}
.search-pill{
  position:absolute;left:50%;transform:translateX(-50%);bottom:115px;
  background:rgba(255,255,255,.66);backdrop-filter:blur(12px);
  padding:7px 14px;border-radius:16px;font-size:13px;color:#777;
}
.dock{
  position:absolute;left:10px;right:10px;bottom:10px;height:92px;
  display:grid;grid-template-columns:repeat(4,1fr);align-items:center;
  background:rgba(255,255,255,.62);backdrop-filter:blur(18px);
  border-radius:28px;padding:10px 8px;
}
.dock .app{font-size:11px}
.dock .icon{width:62px;height:62px;margin-bottom:2px}
.phoneicon{background:linear-gradient(#53ec7b,#09c63f)}
.phoneicon:before{content:"☎";position:absolute;inset:0;color:#fff;font-size:42px;line-height:62px;transform:rotate(-18deg)}
.safari{background:#fff}
.safari:before{content:"";position:absolute;inset:7px;border:3px solid #1ea6ff;border-radius:50%}
.safari:after{content:"";position:absolute;left:29px;top:11px;width:3px;height:42px;background:#ff3b30;transform:rotate(38deg);box-shadow:0 0 0 1px rgba(0,0,0,.05)}
.messages{background:linear-gradient(#62f289,#19ca4a)}
.messages:before{content:"";position:absolute;width:38px;height:29px;border-radius:50%;background:#fff;left:13px;top:14px}
.messages:after{content:"";position:absolute;border-top:8px solid #fff;border-right:8px solid transparent;left:16px;top:37px}
.music{background:linear-gradient(#ff5d72,#ff2d55)}
.music:before{content:"♫";position:absolute;inset:0;color:#fff;font-size:42px;line-height:62px}
.badge{
  position:absolute;right:-5px;top:-7px;background:#ff3b30;color:#fff;
  width:23px;height:23px;border-radius:50%;font-size:13px;font-weight:700;line-height:23px;
}

/* PHONE RECENTS */
.navtop{padding:5px 18px 0}
.edit{color:var(--blue);font-size:15px;font-weight:600}
.segment{
  width:190px;height:32px;margin:-20px auto 12px;background:#ececef;border-radius:9px;padding:2px;display:flex;
}
.segment span{flex:1;text-align:center;font-size:13px;line-height:28px;border-radius:7px}
.segment .selected{background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.1);font-weight:600}
.bigtitle{font-size:31px;font-weight:800;padding:0 18px 10px}
.calls{border-top:1px solid var(--line);padding-left:14px}
.callrow{
  display:grid;grid-template-columns:54px 1fr auto 28px;align-items:center;
  min-height:74px;border-bottom:1px solid var(--line);padding-right:12px;
}
.avatar{
  width:46px;height:46px;border-radius:50%;background:linear-gradient(#c9c9ce,#a9a9ae);position:relative;
}
.avatar:before{content:"";position:absolute;width:15px;height:15px;background:#f5f5f5;border-radius:50%;top:8px;left:15px}
.avatar:after{content:"";position:absolute;width:29px;height:16px;background:#f5f5f5;border-radius:15px 15px 8px 8px;bottom:5px;left:8px}
.callname{font-size:17px;font-weight:700}
.callsub{font-size:13px;color:var(--sub);margin-top:4px}
.calltime{font-size:14px;color:var(--sub);margin-right:8px}
.info{color:var(--blue);border:2px solid var(--blue);width:24px;height:24px;border-radius:50%;font-size:16px;font-weight:700;text-align:center;line-height:20px}
.missed .callname,.missed .callsub{color:#ff3b30}
.tabbar{
  position:absolute;left:0;right:0;bottom:0;height:78px;border-top:1px solid var(--line);background:rgba(255,255,255,.96);
  display:grid;grid-template-columns:repeat(5,1fr);padding-top:8px;
}
.tab{text-align:center;color:#8e8e93;font-size:10px}
.tab .sym{font-size:24px;height:29px}
.tab.active{color:var(--blue)}

/* MESSAGES */
.msg-header{
  border-bottom:1px solid var(--line);padding:0 14px 11px;text-align:center;position:relative;
}
.back{
  position:absolute;left:15px;top:22px;font-size:36px;color:var(--blue);font-weight:300;cursor:pointer;
}
.video{
  position:absolute;right:16px;top:30px;width:31px;height:20px;border:2px solid var(--blue);border-radius:4px;
}
.video:after{content:"";position:absolute;right:-10px;top:3px;border-left:8px solid var(--blue);border-top:6px solid transparent;border-bottom:6px solid transparent}
.msg-avatar{margin:0 auto 4px}
.contact{font-size:14px}
.timestamp{text-align:center;color:var(--sub);font-size:13px;margin-top:24px;line-height:1.2}
.bubble{
  display:inline-block;background:#e9e9ee;border-radius:20px;padding:9px 14px;font-size:18px;margin:14px 0 0 18px;
  position:relative;
}
.bubble:after{content:"";position:absolute;left:-7px;bottom:2px;border-right:11px solid #e9e9ee;border-top:8px solid transparent}
.compose{
  position:absolute;left:12px;right:12px;bottom:17px;display:flex;align-items:center;gap:9px;
}
.plus{width:36px;height:36px;border-radius:50%;background:#ededf0;color:#9c9ca1;font-size:29px;text-align:center;line-height:33px}
.input{
  height:39px;flex:1;border:1px solid #d7d7dc;border-radius:22px;color:#c7c7cc;
  display:flex;align-items:center;justify-content:space-between;padding:0 12px 0 16px;font-size:16px;
}
.mic{font-size:19px;color:#8e8e93}

/* notification */
.notification{
  position:absolute;left:16px;right:16px;top:62px;
  background:rgba(255,255,255,.82);backdrop-filter:blur(25px);
  border-radius:25px;padding:14px 16px 16px;
  box-shadow:0 8px 26px rgba(0,0,0,.12);
}
.notif-top{display:flex;align-items:center;gap:10px;color:#555;font-size:13px}
.notif-mini{width:30px;height:30px;border-radius:8px;background:linear-gradient(#62f289,#19ca4a);position:relative}
.notif-mini:before{content:"";position:absolute;width:18px;height:14px;background:#fff;border-radius:50%;left:6px;top:6px}
.now{margin-left:auto;color:#8e8e93}
.sender{font-weight:800;font-size:19px;margin-top:9px}
.preview{font-size:18px;margin-top:3px}

.home-indicator{
  position:absolute;width:135px;height:5px;border-radius:4px;background:#000;left:50%;transform:translateX(-50%);bottom:5px;z-index:40;
}

@media(max-height:720px){
  body{padding:0}
  .phone{border-radius:0;width:100vw;height:100vh}
}
</style>
</head>
<body>
<div class="phone">

  <section id="homeScreen" class="screen active wallpaper">
    <div class="statusbar">
      <div>9:41</div>
      <div class="statusicons">
        <div class="signal"><i></i><i></i><i></i><i></i></div>
        <div class="wifi"><i></i></div>
        <div class="battery"><i></i></div>
      </div>
    </div>

    <div class="home-content">
      <div class="apps">
        <div class="app"><div class="icon facetime"></div><div>FaceTime</div></div>
        <div class="app"><div class="icon calendar"><div class="dow">월요일</div><div class="date">27</div></div><div>캘린더</div></div>
        <div class="app"><div class="icon photos"></div><div>사진</div></div>
        <div class="app"><div class="icon camera"></div><div>카메라</div></div>

        <div class="app"><div class="icon mail"></div><div>Mail</div></div>
        <div class="app"><div class="icon clock"></div><div>시계</div></div>
        <div class="app"><div class="icon maps"></div><div>지도</div></div>
        <div class="app"><div class="icon weather"></div><div>날씨</div></div>

        <div class="app"><div class="icon reminders"></div><div>미리 알림</div></div>
        <div class="app"><div class="icon notes"></div><div>메모</div></div>
        <div class="app"><div class="icon appstore"></div><div>App Store</div></div>
        <div class="app"><div class="icon settings"></div><div>설정</div></div>
      </div>
      <div class="search-pill">⌕&nbsp; 검색</div>
      <div class="dock">
        <div class="app" onclick="openScreen('phoneScreen')"><div class="icon phoneicon"></div><div>전화</div></div>
        <div class="app"><div class="icon safari"></div><div>Safari</div></div>
        <div class="app" onclick="openScreen('messageScreen')">
          <div class="icon messages"><span class="badge">1</span></div><div>메시지</div>
        </div>
        <div class="app"><div class="icon music"></div><div>음악</div></div>
      </div>
    </div>
  </section>

  <section id="phoneScreen" class="screen">
    <div class="statusbar">
      <div>9:41</div>
      <div class="statusicons">
        <div class="signal"><i></i><i></i><i></i><i></i></div>
        <div class="wifi"><i></i></div>
        <div class="battery"><i></i></div>
      </div>
    </div>
    <div class="navtop">
      <div class="edit" onclick="openScreen('homeScreen')" style="cursor:pointer">편집</div>
      <div class="segment"><span class="selected">전체</span><span>부재중</span></div>
    </div>
    <div class="bigtitle">최근 통화</div>
    <div class="calls">
      <div class="callrow missed" onclick="openScreen('messageScreen')" style="cursor:pointer">
        <div class="avatar"></div><div><div class="callname">자기</div><div class="callsub">↘ 부재중 전화</div></div><div class="calltime">오후 5:42</div><div class="info">i</div>
      </div>
      <div class="callrow"><div class="avatar"></div><div><div class="callname">대영이</div><div class="callsub">☎ 휴대전화</div></div><div class="calltime">오후 3:18</div><div class="info">i</div></div>
      <div class="callrow"><div class="avatar"></div><div><div class="callname">대표님</div><div class="callsub">☎ 휴대전화</div></div><div class="calltime">오후 1:07</div><div class="info">i</div></div>
      <div class="callrow"><div class="avatar"></div><div><div class="callname">엄마</div><div class="callsub">☎ 휴대전화</div></div><div class="calltime">어제</div><div class="info">i</div></div>
      <div class="callrow"><div class="avatar"></div><div><div class="callname">시온</div><div class="callsub">☎ 휴대전화</div></div><div class="calltime">어제</div><div class="info">i</div></div>
      <div class="callrow"><div class="avatar"></div><div><div class="callname">유민</div><div class="callsub">☎ 휴대전화</div></div><div class="calltime">2026. 10. 25.</div><div class="info">i</div></div>
      <div class="callrow"><div class="avatar"></div><div><div class="callname">김재희</div><div class="callsub">☎ 휴대전화</div></div><div class="calltime">2026. 10. 24.</div><div class="info">i</div></div>
    </div>
    <div class="tabbar">
      <div class="tab"><div class="sym">★</div>즐겨찾기</div>
      <div class="tab active"><div class="sym">◷</div>최근 통화</div>
      <div class="tab"><div class="sym">●</div>연락처</div>
      <div class="tab"><div class="sym">⠿</div>키패드</div>
      <div class="tab"><div class="sym">⌘</div>음성 사서함</div>
    </div>
    <div class="home-indicator"></div>
  </section>

  <section id="messageScreen" class="screen">
    <div class="statusbar">
      <div>9:52</div>
      <div class="statusicons">
        <div class="signal"><i></i><i></i><i></i><i></i></div>
        <div class="wifi"><i></i></div>
        <div class="battery"><i></i></div>
      </div>
    </div>
    <div class="msg-header">
      <div class="back" onclick="openScreen('homeScreen')">‹</div>
      <div class="avatar msg-avatar"></div>
      <div class="contact">자기 ›</div>
      <div class="video"></div>
    </div>
    <div class="timestamp">iMessage<br>(오늘) 오후 5:42</div>
    <div class="bubble">미안해</div>
    <div class="compose">
      <div class="plus">＋</div>
      <div class="input"><span>iMessage</span><span class="mic">🎙</span></div>
    </div>
    <div class="home-indicator"></div>
  </section>

  <section id="notificationScreen" class="screen wallpaper">
    <div class="statusbar">
      <div>9:41</div>
      <div class="statusicons">
        <div class="signal"><i></i><i></i><i></i><i></i></div>
        <div class="wifi"><i></i></div>
        <div class="battery"><i></i></div>
      </div>
    </div>
    <div class="notification" onclick="openScreen('messageScreen')" style="cursor:pointer">
      <div class="notif-top">
        <div class="notif-mini"></div>
        <div>메시지</div>
        <div class="now">지금</div>
      </div>
      <div class="sender">자기</div>
      <div class="preview">미안해</div>
    </div>
  </section>

</div>

<script>
function openScreen(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}
</script>
</body>
</html>
